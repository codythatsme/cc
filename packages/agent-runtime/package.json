{
  "name": "@cc/agent-runtime",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test": {
      "source": "./src/test/index.ts",
      "types": "./src/test/index.ts",
      "default": "./src/test/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "generate:test-bridges": "node ./scripts/build-test-bridges.mjs",
    "lint": "oxlint src",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@cc/domain": "workspace:*",
    "@cc/process-utils": "workspace:*",
    "@cc/provider-bridge-protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@cc/test-helpers": "workspace:*",
    "@cc/tsconfig": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "cc-plugin-scripted-echo-provider": "workspace:*",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
