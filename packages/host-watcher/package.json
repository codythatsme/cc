  },
  "dependencies": {
    "@cc/domain": "workspace:*",
    "@cc/process-utils": "workspace:*",
    "@parcel/watcher": "2.6.0"
  },
  "devDependencies": {
    "@cc/test-helpers": "workspace:*",
    "@cc/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
