{
  "name": "@cc/scripts",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "bin": {
    "cc-script-archive-codex-tmp-cc-sessions": "./dist/commands/archive-codex-tmp-cc-sessions.js",
    "cc-script-reset-cc-data": "./dist/commands/reset-cc-data.js",
    "cc-script-run-cli": "./dist/commands/run-cli.js"
  },
  "exports": {
    "./lib/run-dev-supervisor": {
      "source": "./src/lib/run-dev-supervisor.ts",
      "types": "./src/lib/run-dev-supervisor.ts",
      "import": "./dist/lib/run-dev-supervisor.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@cc/config": "workspace:*",
    "@cc/db": "workspace:*",
    "@cc/domain": "workspace:*",
    "@cc/host-daemon-contract": "workspace:*",
    "@cc/process-utils": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@cc/test-helpers": "workspace:*",
    "@cc/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
