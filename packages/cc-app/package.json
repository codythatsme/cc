{
  "name": "cc-app",
  "version": "0.44.0",
  "description": "cc app launcher for npx",
  "keywords": [
    "cc",
    "coding-agent",
    "agent",
    "cli",
    "workspace",
    "codex",
    "claude-code"
  ],
  "homepage": "https://github.com/codythatsme/cc#readme",
  "bugs": {
    "url": "https://github.com/codythatsme/cc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codythatsme/cc.git",
    "directory": "packages/cc-app"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/public-sdk.ts",
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/cc-app.js": "./dist/cc-app.js"
  },
  "types": "./dist/index.d.ts",
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "cc-app": "dist/cc-app.js",
    "cc": "dist/cc.js",
    "cc-server": "dist/cc-server.js",
    "cc-host-daemon": "dist/cc-host-daemon.js"
  },
  "files": [
    "app/dist",
    "dist",
    "host-daemon/dist/cc",
    "host-daemon/dist/cc-chunks",
    "host-daemon/dist/cc-parcel-watcher-child.mjs",
    "host-daemon/dist/cc-plugin-host-worker.mjs",
    "host-daemon/dist/cc-provider-bridge-worker.mjs",
    "host-daemon/dist/daemon-bundle.mjs",
    "server/dist",
    "README.md",
    "!**/*.map",
    "host-daemon/dist/plugin-sdk"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "clean": "rimraf dist app host-daemon server tsconfig.tsbuildinfo",
    "prepack": "node dist/prune-cc-chunks.mjs",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@parcel/watcher": "2.5.6",
    "better-sqlite3": "13.0.3",
    "fs-native-extensions": "1.5.0",
    "hono": "^4.7.0",
    "jiti": "^2.6.1",
    "node-pty": "1.2.0-beta.15",
    "npm": "11.16.0",
    "picocolors": "^1.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cc/config": "workspace:*",
    "@cc/host-daemon-contract": "workspace:*",
    "@cc/sdk": "workspace:*",
    "@cc/server-archive": "workspace:*",
    "@cc/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "rimraf": "^6.1.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "semver": "^7.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  },
  "private": true
}
