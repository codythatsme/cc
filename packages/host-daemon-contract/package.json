{
  "name": "@cc/host-daemon-contract",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./local": {
      "source": "./src/local.ts",
      "types": "./src/local.ts",
      "default": "./src/local.ts"
    },
    "./protocol": {
      "source": "./src/protocol.ts",
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./skill-tree": {
      "source": "./src/skill-tree.ts",
      "types": "./src/skill-tree.ts",
      "default": "./src/skill-tree.ts"
    },
    "./workspace": {
      "source": "./src/workspace.ts",
      "types": "./src/workspace.ts",
      "default": "./src/workspace.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@cc/domain": "workspace:*",
    "@cc/hono-typed-routes": "workspace:*",
    "@cc/provider-bridge-protocol": "workspace:*",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cc/test-helpers": "workspace:*",
    "@cc/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
