{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CC_BUILD_TOOLCHAIN"],
  "globalPassThroughEnv": ["npm_config_store_dir", "pnpm_config_store_dir"],
  "tasks": {
    "@cc/db#db:generate": { "cache": false },
    "@cc/desktop#smoke:browser-broker": {
      "cache": false,
      "dependsOn": [
        "@cc/templates#generate:templates",
        "@codythatsme/plugin-sdk#build:types",
        "@cc/cli#build"
      ],
      "outputs": []
    },
    "@cc/desktop#smoke:browser-cdp": {
      "cache": false,
      "dependsOn": ["topo"],
      "passThroughEnv": ["DISPLAY"]
    },
    "@cc/web#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/CHANGELOG.md",
        "$TURBO_ROOT$/changelog-metadata.ts",
        "$TURBO_ROOT$/changelog-parser.ts",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/apps/web/tsconfig.json",
        "$TURBO_ROOT$/apps/web/vite.config.ts",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json"
      ],
      "env": ["CLOUDFLARE_ENV"],
      "outputs": ["dist/**"]
    },
    // Mirrors "build" but also caches bundle-stats.json, which the
    // cc:bundle-stats Vite plugin writes beside dist for the boot-payload
    // budget check. Without it a cache hit would leave CI checking a stale
    // file, or none at all.
    // The docs' UI-anatomy manifest is the contract this test checks the real
    // app components against, so a manifest edit must re-run it.
    "@cc/app#test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/CHANGELOG.md",
        "$TURBO_ROOT$/changelog-metadata.ts",
        "$TURBO_ROOT$/changelog-parser.ts",
        "$TURBO_ROOT$/plugins/plugin-api-docs/src/anatomy-manifest.json",
        "$TURBO_ROOT$/plugins/theme-preview/taxonomy.ts",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    "@cc/app#build": {
      "env": [
        "NODE_OPTIONS",
        "NODE_ENV",
        "BABEL_*",
        "ENABLE_REACT_COMPILER_TIMINGS",
        "VITE_*"
      ],
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/.env*",
        ".env*",
        "$TURBO_ROOT$/CHANGELOG.md",
        "$TURBO_ROOT$/changelog-metadata.ts",
        "$TURBO_ROOT$/changelog-parser.ts",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/scripts/build-package.mjs",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs",
        "$TURBO_ROOT$/scripts/precompress-app-dist.mjs",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": ["bundle-stats.json", "dist/**"]
    },
    "build": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/scripts/build-package.mjs",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs",
        "$TURBO_ROOT$/scripts/precompress-app-dist.mjs",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": ["dist/**"]
    },
    "@cc/sdk#test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/apps/*/scripts/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/tsconfig.json",
        "$TURBO_ROOT$/apps/*/vite.config.ts",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/scripts/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/db/drizzle/**",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    "@cc/server#build": {
      "dependsOn": ["topo"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/cc-guide/skills/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/scripts/build-package.mjs",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs",
        "$TURBO_ROOT$/turbo.json"
      ]
    },
    "@cc/plugin-build#build": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/packages/cc-app/package.json"
      ],
      "outputs": ["dist/**"]
    },
    "prepare:bundled": {
      "dependsOn": ["topo", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!.bundled-runtime/**",
        "$TURBO_ROOT$/packages/plugin-registry/flavors/**"
      ],
      "outputs": [".bundled-runtime/**"]
    },
    "@cc/bundled-plugins#build": {
      "dependsOn": [
        "^prepare:bundled",
        "@cc/server#generate:cc-official-marketplace"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/src/services/plugins/builtin-registry.ts",
        "$TURBO_ROOT$/apps/server/src/services/plugin-catalog/bundled-marketplace-paths.ts"
      ],
      "outputs": ["dist/**"]
    },
    "cc-app#build": {
      "dependsOn": [
        "@cc/app#build",
        "@cc/server#build",
        "@cc/bundled-plugins#build",
        "@cc/host-daemon#build",
        "@cc/cli#build",
        "@cc/sdk#build",
        "@codythatsme/plugin-sdk#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/cc-app/package.json",
        "$TURBO_ROOT$/packages/cc-app/scripts/**",
        "$TURBO_ROOT$/packages/cc-app/src/**",
        "$TURBO_ROOT$/packages/cc-app/tsconfig.json",
        "$TURBO_ROOT$/packages/sdk/package.json",
        "$TURBO_ROOT$/packages/sdk/src/**",
        "$TURBO_ROOT$/packages/sdk/tsconfig.json",
        "$TURBO_ROOT$/packages/shared-ui/package.json",
        "$TURBO_ROOT$/packages/shared-ui/src/**",
        "$TURBO_ROOT$/packages/shared-ui/tsconfig.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/scripts/*.mjs"
      ],
      "outputs": ["app/**", "dist/**", "host-daemon/**", "server/**"]
    },
    "cc-app#build:host": {
      "dependsOn": ["@cc/host-daemon#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/host-daemon/dist/**",
        "$TURBO_ROOT$/packages/cc-app/package.json",
        "$TURBO_ROOT$/packages/cc-app/scripts/build-host.mjs",
        "$TURBO_ROOT$/packages/cc-app/src/**",
        "$TURBO_ROOT$/packages/cc-app/tsconfig.json",
        "$TURBO_ROOT$/packages/config/package.json",
        "$TURBO_ROOT$/packages/config/src/**",
        "$TURBO_ROOT$/packages/config/tsconfig.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs"
      ],
      "outputs": ["host-package/**"]
    },
    "cc-plugin-tasks#build": {
      // The tasks plugin's app bundle imports the @codythatsme/plugin-sdk root at
      // runtime (shared RPC contract), so the SDK dist must exist first.
      "dependsOn": ["topo", "@codythatsme/plugin-sdk#build"]
    },
    "@cc/desktop#build": {
      "dependsOn": ["cc-app#build"],
      "env": ["CC_DESKTOP_RELEASE_CHANNEL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/**",
        "$TURBO_ROOT$/packages/cc-app/app/**",
        "$TURBO_ROOT$/packages/cc-app/dist/**",
        "$TURBO_ROOT$/packages/cc-app/host-daemon/**",
        "$TURBO_ROOT$/packages/cc-app/package.json",
        "$TURBO_ROOT$/packages/cc-app/server/**",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": ["dist/**"]
    },
    "@cc/desktop#desktop:build": {
      "dependsOn": ["cc-app#build", "@cc/desktop#build"],
      "cache": false,
      "outputs": ["release/**"],
      "passThroughEnv": ["*"]
    },
    "@cc/desktop#desktop:build:linux": {
      "dependsOn": ["cc-app#build", "@cc/desktop#build"],
      "cache": false,
      "outputs": ["release/**"],
      "passThroughEnv": ["*"]
    },
    "@cc/desktop#smoke:packaged": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@cc/desktop#smoke:packaged-npm": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CC_DESKTOP_RELEASE_CHANNEL"]
    },
    "@cc/desktop#package": {
      "dependsOn": ["cc-app#build", "@cc/desktop#build"],
      "cache": false,
      "outputs": ["release/**"],
      "passThroughEnv": ["*"]
    },
    "@cc/desktop#package:linux": {
      "dependsOn": ["cc-app#build", "@cc/desktop#build"],
      "cache": false,
      "outputs": ["release/**"],
      "passThroughEnv": ["*"]
    },
    "@cc/desktop#smoke:appimage-lifecycle": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@cc/desktop#dev": {
      "dependsOn": ["cc-app#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@cc/desktop#start": {
      "dependsOn": ["cc-app#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "bundle": {
      "cache": false,
      "outputs": []
    },
    "@cc/app#dev": {
      "dependsOn": ["@cc/templates#generate:templates"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@cc/mobile#test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/apps/app/src/components/ui/theme.css",
        "$TURBO_ROOT$/apps/app/src/lib/themes/**"
      ]
    },
    "@cc/mobile#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "storybook": {
      "dependsOn": ["@cc/templates#generate:templates"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@cc/host-daemon#dev": {
      // The source daemon injects apps/cli/bin/cc into agent shells. Build its
      // gitignored runtime before the daemon starts so a sandboxed thread never
      // has to write back into the daemon's checkout to bootstrap `cc`.
      "dependsOn": [
        "@cc/cli#build",
        "@cc/templates#generate:templates",
        "@cc/plugin-build#generate"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@cc/server#dev": {
      // The server installs first-party provider plugins during startup and
      // builds their host artifacts. Those builds resolve the published
      // `@codythatsme/plugin-sdk/provider-bridge` entry from the SDK dist, so a
      // clean worktree must build that runtime before the server starts.
      "dependsOn": [
        "@cc/server#generate:cc-official-marketplace",
        "@cc/templates#generate:templates",
        "@cc/plugin-build#generate",
        "@codythatsme/plugin-sdk#build:runtime"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@cc/host-daemon#start:prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@cc/server#start:prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/packages/plugin-registry/r/**",
        "$TURBO_ROOT$/scripts/forkable-plugins.json",
        "$TURBO_ROOT$/scripts/oxlint-plugin.mjs"
      ]
    },
    "//#ensure-native-modules": {
      "cache": false,
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/db/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/scripts/ensure-native-modules.mjs"
      ],
      "outputs": []
    },
    // Transit node (no package defines a `topo` script; nothing executes).
    // It exists so tasks that resolve `@cc/*` imports to *sources* — vitest
    // and tsc both use the `source` export condition — hash the sources of
    // dependency packages. Without it, a change in e.g. packages/domain
    // would cache-hit @cc/server#test/#typecheck and skip them stale.
    "topo": {
      "dependsOn": ["^topo"]
    },
    // ---- Source generators --------------------------------------------------
    // Generated modules are never committed (see .gitignore). Each generator
    // is a turbo task with explicit inputs/outputs, so staleness is
    // structurally impossible and the files can never merge-conflict.
    //
    // The owning package's `topo` node depends on its generators, so every
    // task of that package and of every package that (transitively) depends
    // on it — the ones that can resolve the generated sources — is ordered
    // after them and hashes them. Unrelated packages are untouched.
    "@cc/templates#topo": {
      "dependsOn": [
        "^topo",
        "@cc/templates#generate:templates",
        "@cc/templates#generate:plugin-scaffold"
      ]
    },
    "@cc/plugin-build#topo": {
      "dependsOn": ["^topo", "@cc/plugin-build#generate"]
    },
    "@cc/server#topo": {
      "dependsOn": ["^topo", "@cc/server#generate:cc-official-marketplace"]
    },
    "@cc/server#generate:cc-official-marketplace": {
      "dependsOn": [],
      "inputs": [
        "scripts/generate-cc-official-marketplace.ts",
        "src/services/plugin-catalog/bundled-marketplace-paths.ts",
        "src/services/plugins/builtin-registry.ts",
        "$TURBO_ROOT$/packages/domain/src/plugin-catalog-category.ts",
        "$TURBO_ROOT$/packages/domain/src/plugin-id.ts",
        "$TURBO_ROOT$/packages/domain/src/plugin-manifest.ts",
        "$TURBO_ROOT$/plugins/*/package.json",
        "$TURBO_ROOT$/plugins/*/PLUGIN_OVERVIEW.md",
        "$TURBO_ROOT$/plugins/cc-official.json"
      ],
      "outputs": ["src/generated/cc-official-marketplace/marketplace.json"]
    },
    "@cc/templates#generate:templates": {
      "dependsOn": [],
      "inputs": [
        "scripts/generate-templates.mjs",
        "scripts/write-generated.mjs",
        "src/templates/**"
      ],
      "outputs": ["src/generated/templates.generated.ts"]
    },
    // The `cc plugin new` starter files from the (committed) component
    // registry.
    "@cc/templates#generate:plugin-scaffold": {
      "dependsOn": [],
      "inputs": [
        "scripts/generate-plugin-scaffold.mjs",
        "scripts/write-generated.mjs",
        "$TURBO_ROOT$/apps/app/package.json",
        "$TURBO_ROOT$/packages/plugin-build/src/runtime-shims.mjs",
        "$TURBO_ROOT$/packages/plugin-registry/r/**"
      ],
      "outputs": ["src/generated/plugin-starter-files.generated.ts"]
    },
    // Plugin theme CSS (from the app's theme.css + tw-animate-css) and the
    // shared-runtime export manifest (introspected from installed packages).
    "@cc/plugin-build#generate": {
      "dependsOn": [],
      "inputs": [
        "scripts/generate-plugin-theme.mjs",
        "scripts/generate-runtime-export-manifest.mjs",
        "src/runtime-shims.mjs",
        "$TURBO_ROOT$/apps/app/package.json",
        "$TURBO_ROOT$/apps/app/src/components/ui/theme.css",
        "$TURBO_ROOT$/packages/plugin-sdk/src/**",
        "$TURBO_ROOT$/packages/shared-ui/src/**",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["topo"]
    },
    "@cc/app#typecheck": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/changelog-metadata.ts",
        "$TURBO_ROOT$/changelog-parser.ts"
      ]
    },
    "@cc/web#typecheck": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/changelog-metadata.ts",
        "$TURBO_ROOT$/changelog-parser.ts"
      ]
    },
    "@cc/host-daemon#build": {
      "dependsOn": [
        "topo",
        "@codythatsme/plugin-sdk#build",
        "@codythatsme/plugin-sdk#build:types"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/scripts/build-package.mjs",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/packages/plugin-build/src/zod-locale-stub.mjs",
        "$TURBO_ROOT$/scripts/precompress-app-dist.mjs",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": ["dist/**"]
    },
    "@cc/cli#build": {
      "dependsOn": [
        "topo",
        "@codythatsme/plugin-sdk#build",
        "@codythatsme/plugin-sdk#build:types"
      ],
      "outputs": ["dist/**"]
    },
    "@cc/cli#test": {
      "dependsOn": [
        "//#ensure-native-modules",
        "topo",
        "@codythatsme/plugin-sdk#build",
        "@codythatsme/plugin-sdk#build:types"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/cc-guide/skills/cc-cli/**",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    // Integration tests typecheck without the `source` condition, so
    // @codythatsme/plugin-sdk (reached through apps/server sources) resolves to the
    // package's published `types`: bundled-types/.
    "@cc/integration-tests#typecheck": {
      "dependsOn": ["@codythatsme/plugin-sdk#build:types", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/package.json",
        "$TURBO_ROOT$/apps/server/tsconfig.json",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/packages/templates/package.json",
        "$TURBO_ROOT$/packages/templates/scripts/**",
        "$TURBO_ROOT$/packages/templates/src/**",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    // The source-wrapper test invokes the root `pnpm cc` script, which builds
    // and executes @cc/cli. Model that cross-package dependency so CLI changes
    // cannot leave this test hidden behind a stale Turbo cache entry.
    "@cc/scripts#test": {
      "dependsOn": ["//#ensure-native-modules", "@cc/cli#build", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/actions/setup-workspace/**",
        "$TURBO_ROOT$/.github/APPROVED_CONTRIBUTORS",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/plugins/*/package.json",
        "$TURBO_ROOT$/plugins/plugin-api-docs/src/first-party-plugins.json",
        "$TURBO_ROOT$/packages/bundled-plugins/package.json",
        "$TURBO_ROOT$/apps/server/src/services/plugins/builtin-registry.ts",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    "@cc/provider-parity#test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/plugin-sdk/package.json",
        "$TURBO_ROOT$/packages/plugin-sdk/src/**",
        "$TURBO_ROOT$/plugins/provider-acp/package.json",
        "$TURBO_ROOT$/plugins/provider-acp/src/**",
        "$TURBO_ROOT$/plugins/provider-acp/tsconfig.json",
        "$TURBO_ROOT$/plugins/provider-claude-code/package.json",
        "$TURBO_ROOT$/plugins/provider-claude-code/src/**",
        "$TURBO_ROOT$/plugins/provider-claude-code/tsconfig.json",
        "$TURBO_ROOT$/plugins/provider-codex/package.json",
        "$TURBO_ROOT$/plugins/provider-codex/src/**",
        "$TURBO_ROOT$/plugins/provider-codex/tsconfig.json",
        "$TURBO_ROOT$/plugins/provider-pi/package.json",
        "$TURBO_ROOT$/plugins/provider-pi/src/**",
        "$TURBO_ROOT$/plugins/provider-pi/tsconfig.json",
        "$TURBO_ROOT$/vitest.shared.ts"
      ],
      "passThroughEnv": ["UPDATE_PARITY_ROW_COUNTS"]
    },
    "test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"],
      // Re-pin knobs a suite reads to rewrite its own committed baseline.
      // Turbo strips undeclared variables, so a documented re-pin command
      // (`UPDATE_PARITY_ROW_COUNTS=1 pnpm exec turbo run test …`) silently
      // does nothing without them.
      "passThroughEnv": [
        "UPDATE_PARITY_ROW_COUNTS",
        "UPDATE_TRANSCRIPT_EXPECTATIONS"
      ]
    },
    "@cc/desktop#test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"],
      "passThroughEnv": ["DISPLAY"]
