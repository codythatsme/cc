        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/plugins/*/icons/**",
        "$TURBO_ROOT$/examples/plugins/*/icons/**"
      ]
    },
    // Runtime unit suites restart the scripted echo provider repeatedly. Build
