    "@cc/agent-runtime#generate:test-bridges": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/domain/src/**",
        "$TURBO_ROOT$/packages/plugin-sdk/src/**",
