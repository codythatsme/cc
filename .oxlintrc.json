{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "jsPlugins": ["./scripts/oxlint-plugin.mjs"],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "rules": {
    "cc/no-comments": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/routeTree.gen.ts",
    "apps/mobile/ios/**",
    "apps/mobile/android/**",
    "apps/mobile/.expo/**",
    "packages/templates/src/generated/**",
    "packages/plugin-build/src/generated/**",
    "packages/plugin-sdk/bundled-types/**"
  ],
  "overrides": [
    {
      "files": [
        "packages/domain/src/native-roots.ts",
        "packages/plugin-sdk/src/*.{ts,tsx}",
        "packages/plugin-sdk/src/internal/*.{ts,tsx}",
        "packages/plugin-sdk/src/testing/*.{ts,tsx}"
      ],
      "rules": {
        "cc/no-comments": "off"
      }
    },
    {
      "files": ["**/*.{ts,tsx}"],
      "plugins": ["react"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/void-use-memo": "error",
        "react/preserve-manual-memoization": "warn",
        "react/incompatible-library": "warn",
        "react/immutability": "warn",
        "react/globals": "error",
        "react/refs": "warn",
        "react/set-state-in-effect": "warn",
        "react/error-boundaries": "error",
        "react/purity": "warn",
        "react/set-state-in-render": "error",
        "react/unsupported-syntax": "warn"
      }
    },
    {
      "files": ["apps/app/**/*.{ts,tsx}", "packages/shared-ui/**/*.{ts,tsx}"],
      "plugins": ["react"],
      "rules": {
        "react/preserve-manual-memoization": "error",
        "react/incompatible-library": "error",
        "react/immutability": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",
        "react/purity": "error",
        "react/unsupported-syntax": "error"
      }
    },
    {
      "files": ["apps/**/*.{ts,tsx}", "packages/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:child_process",
                "importNames": ["spawnSync", "execSync", "execFileSync"],
                "message": "Use async child_process APIs instead of blocking sync variants."
              },
              {
                "name": "child_process",
                "importNames": ["spawnSync", "execSync", "execFileSync"],
                "message": "Use async child_process APIs instead of blocking sync variants."
              }
            ]
          }
        ],
        "cc/no-blocking-child-process-call": "error"
      }
    },
    {
      "files": [
        "packages/agent-runtime/src/**/*.ts",
        "packages/provider-bridge-acp/src/bridge/agent-connection.ts",
        "packages/config/src/verified-process-stop.ts",
        "packages/host-workspace/src/git-host.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:child_process",
                "allowTypeImports": true,
                "message": "Use @cc/process-utils managed processes or buffered commands so launch and termination share one owner."
              },
              {
                "name": "child_process",
                "allowTypeImports": true,
                "message": "Use @cc/process-utils managed processes or buffered commands so launch and termination share one owner."
              },
              {
                "name": "cross-spawn",
                "allowTypeImports": true,
                "message": "Use @cc/process-utils managed processes or buffered commands so launch and termination share one owner."
              },
              {
                "name": "@cc/process-utils",
                "importNames": [
                  "spawnPortableProcess",
                  "spawnPortablePipedProcess",
                  "spawnPortableOutputProcess",
                  "supportsProcessGroups",
                  "killProcessGroup",
                  "stopProcessGroupLeaderFirst"
                ],
                "message": "Use spawnManagedProcess for owned subprocesses; it owns process-group setup and awaited termination."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/process-utils/src/host-toolchain.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "cc/no-blocking-child-process-call": "off"
      }
    },
    {
      "files": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/scripts/**"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "cc/no-blocking-child-process-call": "off"
      }
    },
    {
      "files": ["apps/server/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@cc/host-workspace",
                "message": "Server must not access workspaces directly. Use daemon commands instead."
              },
              {
                "name": "@cc/host-watcher",
                "message": "Server must not access host watchers directly. Use daemon commands instead."
              },
              {
                "name": "node:fs",
                "message": "Server must not use node:fs. Use daemon commands for workspace access. (attachments.ts is the only exception — it manages server-local storage.)"
              },
              {
                "name": "node:fs/promises",
                "message": "Server must not use node:fs/promises. Use daemon commands for workspace access. (attachments.ts is the only exception — it manages server-local storage.)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/server/src/**/__tests__/**",
        "apps/server/src/**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/mobile/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@cc/sdk",
                "message": "Import @cc/sdk/browser: the root entry resolves to the Node SDK under Metro's source condition."
              }
            ],
            "patterns": [
              {
                "group": ["@cc/shared-ui", "@cc/shared-ui/*"],
                "message": "@cc/shared-ui is React DOM + Radix. Use the mobile primitives instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/app/src/**/*.{ts,tsx}"],
      "rules": {
        "cc/no-native-title-with-aria-label": "error",
        "cc/no-native-title-on-button": "error"
      }
    },
    {
      "files": [
        "apps/app/src/**/*.test.ts",
        "apps/app/src/**/*.test.tsx",
        "apps/app/src/**/*.stories.tsx"
      ],
      "rules": {
        "cc/no-native-title-with-aria-label": "off",
        "cc/no-native-title-on-button": "off"
      }
    },
    {
      "files": ["plugins/**/*.{ts,tsx,mts,cts,js,mjs,cjs}"],
      "rules": {
        "cc/forkable-plugin-imports": "error"
      }
    },
    {
      "files": [
        "apps/**/*.{ts,tsx}",
        "packages/**/*.{ts,tsx}",
        "plugins/**/*.{ts,tsx}"
      ],
      "rules": {
        "cc/no-raw-resize-observer": "error"
      }
    },
    {
      "files": [
        "packages/shared-ui/src/lib/shared-resize-observer.ts",
        "apps/app/src/components/ui/scroll-position-keeper.ts",
        "apps/web/src/landing/hero-window-stage.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.stories.tsx"
      ],
      "rules": {
        "cc/no-raw-resize-observer": "off"
      }
    }
  ]
}
