{
  "name": "cc-plugin-pdf-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preview PDF files with the browser's built-in viewer.",
  "engines": {
    "cc": ">=0.0",
    "ccPluginSdk": ">=0.4.8"
  },
  "cc": {
    "name": "PDF preview",
    "description": "Preview PDF files with the browser's built-in viewer.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "cc-plugin-build prepare-bundled"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
