{
  "name": "cc-plugin-cc--github-pr-status",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub pull request status and actions for each environment's branch",
  "engines": {
    "cc": ">=0.0",
    "ccPluginSdk": ">=0.6.94"
  },
  "cc": {
    "name": "GitHub PR Status",
    "description": "GitHub pull request status and actions for each environment's branch",
    "branding": {
      "icon": "GitPullRequest"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "exports": {
    "./contract": "./contract.ts",
    "./read-contract": "./read-contract.ts",
    "./refetch-on-show": "./ui/refetch-on-show.ts"
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "cc-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@cc/shared-ui": "workspace:*",
    "cc-environment-provider-host": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
