{
  "name": "cc-plugin-plugin-api-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browse the cc plugin API as an annotated map of the product.",
  "engines": {
    "cc": ">=0.0",
    "ccPluginSdk": ">=0.4.3"
  },
  "cc": {
    "name": "Plugin Guide",
    "description": "Browse the cc plugin API as an annotated map of the product.",
    "branding": {
      "icon": "./icons/ai-generative.svg",
      "experimental_icons": {
        "guide": "./icons/ai-generative.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "cc-plugin-build prepare-bundled",
    "scaffold:surface-entry": "node scripts/scaffold-surface-entry.mjs"
  },
  "dependencies": {
    "@cc/shared-ui": "workspace:*",
    "@hugeicons/core-free-icons": "~4.3.4",
    "@hugeicons/react": "^1.1.10"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
