{
  "name": "cc-plugin-memory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Provider-independent durable memory for agents. We recommend disabling provider-native memory when using this plugin.",
  "license": "MIT",
  "homepage": "https://github.com/codythatsme/cc#readme",
  "bugs": {
    "url": "https://github.com/codythatsme/cc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codythatsme/cc.git",
    "directory": "plugins/memory"
  },
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "skills",
    "README.md"
  ],
  "engines": {
    "cc": ">=0.0",
    "ccPluginSdk": ">=0.4.102"
  },
  "cc": {
    "name": "Memory",
    "description": "Provider-independent durable memory for agents. We recommend disabling provider-native memory when using this plugin.",
    "branding": {
      "icon": "Brain"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "build": "node --conditions=source --import tsx ../../scripts/build-official-plugins.mjs memory",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "cc-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@cc/shared-ui": "workspace:*",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1"
  }
}
