{
  "name": "cc-plugin-provider-acp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run cc threads with ACP agents (supports Cursor, opencode, omp and more).",
  "engines": {
    "cc": ">=0.0",
    "ccPluginSdk": ">=0.4.90"
  },
  "cc": {
    "name": "ACP providers",
    "description": "Run cc threads with ACP agents (supports Cursor, opencode, omp and more).",
    "branding": {
      "icon": "./icons/acp.svg",
      "experimental_icons": {
        "cursor": "./icons/cursor.svg",
        "opencode": "./icons/opencode.svg",
        "omp": "./icons/omp.svg",
        "grok": "./icons/grok.svg",
        "hermes-agent": "./icons/hermes-agent.svg"
      }
    },
    "server": "./server.ts",
    "host": "./src/host.ts"
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "cc-plugin-build prepare-bundled"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@codythatsme/plugin-sdk": "workspace:*",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  }
}
