{
  "name": "cc-plugin-cc-account",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Signs this cc in to your cc.example.invalid account and holds its server credential for remote access and hosted services.",
  "engines": {
    "cc": ">=0.0",
    "ccPluginSdk": ">=0.6.63"
  },
  "cc": {
    "name": "cc account",
    "description": "Signs this cc in to your cc.example.invalid account and holds its server credential for remote access and hosted services.",
    "branding": {
      "icon": "UserRound"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "cc-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@cc/connect-client": "workspace:*",
    "@cc/shared-ui": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12",
    "ws": "^8.22.1"
  }
}
