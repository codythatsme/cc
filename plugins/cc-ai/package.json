{
  "name": "cc-plugin-cc-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thread titles, commit messages, and voice input from cc cloud, included with your cc account.",
  "engines": {
    "cc": ">=0.0",
    "ccPluginSdk": ">=0.5.24"
  },
  "cc": {
    "name": "cc cloud AI",
    "description": "Thread titles, commit messages, and voice input from cc cloud, included with your cc account.",
    "branding": {
      "icon": "AiBrain01"
    },
    "server": "./src/server.ts",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "cc-plugin-build prepare-bundled"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
