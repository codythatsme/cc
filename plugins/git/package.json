{
  "name": "cc-plugin-cc--git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Git status, changed files and the Diff tab for each environment",
  "engines": {
    "cc": ">=0.0",
    "ccPluginSdk": ">=0.6.90"
  },
  "cc": {
    "name": "Git",
    "description": "Git status, changed files and the Diff tab for each environment",
    "branding": {
      "icon": "GitBranch"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "exports": {
    "./contract": "./contract.ts",
    "./rpc-contract": "./rpc-contract.ts",
    "./status-state": "./status-state.ts",
    "./testing": "./testing.ts"
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "cc-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@cc/async-cache": "workspace:*",
    "@cc/domain": "workspace:*",
    "@cc/server-contract": "workspace:*",
    "@cc/shared-ui": "workspace:*",
    "@cc/thread-view": "workspace:*",
    "@tanstack/react-virtual": "3.14.20",
    "cc-environment-provider-host": "workspace:*",
    "mime-types": "^3.0.2",
    "picomatch": "^4.0.7",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cc/host-daemon-contract": "workspace:*",
    "@cc/plugin-build": "workspace:*",
    "@cc/test-helpers": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
