{
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["@codythatsme/plugin-sdk#build:types", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/plugin-registry/flavors/**"
      ]
    },
    "build": {
      "dependsOn": ["@codythatsme/plugin-sdk#build:types", "@cc/cli#build"],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "//#ensure-native-modules",
        "@codythatsme/plugin-sdk#build",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/plugin-registry/flavors/**"
      ],
      "cache": false
    },
    "smoke": {
      "cache": false,
      "dependsOn": ["@codythatsme/plugin-sdk#build"],
      "passThroughEnv": ["DEV_BROWSER_SMOKE_BINARY", "DEV_BROWSER_SMOKE_CHROME"]
    },
    "smoke:install": {
      "cache": false,
      "dependsOn": ["@codythatsme/plugin-sdk#build"],
      "passThroughEnv": ["DEV_BROWSER_SMOKE_CHROME"]
    }
  }
}
