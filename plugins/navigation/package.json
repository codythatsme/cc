{
  "name": "cc-plugin-navigation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "cc's sidebar navigation: New thread, Search, Plugins, Skills, and plugin panels.",
  "engines": {
    "cc": ">=0.0",
    "ccPluginSdk": ">=0.5.13"
  },
  "cc": {
    "name": "Navigation",
    "description": "cc's sidebar navigation: New thread, Search, Plugins, Skills, and plugin panels.",
    "branding": {
      "icon": "PanelLeft"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "cc-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@cc/shared-ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
