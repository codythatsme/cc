{
  "name": "cc-plugin-environment-git-worktree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run a thread in a fresh git worktree on an enrolled machine",
  "engines": {
    "cc": ">=0.0"
  },
  "cc": {
    "name": "Worktree",
    "description": "Run a thread in a fresh git worktree on an enrolled machine",
    "branding": {
      "icon": "FolderGit"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "prepare:bundled": "cc-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@cc/shared-ui": "workspace:*",
    "cc-environment-provider-host": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
