{
  "name": "cc-plugin-cc-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control the CC introduction and bundled agent skills.",
  "engines": {
    "cc": ">=0.0",
    "ccPluginSdk": ">=0.6.0"
  },
  "cc": {
    "name": "CC guide",
    "description": "Control the CC introduction and bundled agent skills.",
    "branding": {
      "icon": "Explore"
    },
    "server": "./server.ts",
    "app": "./app.ts"
  },
  "keywords": [
    "cc-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "cc-plugin-build prepare-bundled",
    "generate:api-index": "node ../../packages/plugin-sdk/scripts/generate-api-index.mjs skills/cc-plugin-authoring/references"
  },
  "devDependencies": {
    "@cc/plugin-build": "workspace:*",
    "@codythatsme/plugin-sdk": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "better-sqlite3": "12.11.1",
    "cron-parser": "^5.10.3",
    "hono": "4.13.16",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
