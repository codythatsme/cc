// cc connect — tunnel gate worker + TunnelDO.
//
// The gate resolves `<handle>.<BASE_DOMAIN>` to a server row in D1, authenticates
// the tunnel client by durable credential and visitors by better-auth session,
// then proxies through the per-handle TunnelDO. Staging serves per-handle custom
// domains attached on demand (e.g. sawyer.cc-staging.example.invalid).
//
// Deploy prod:    pnpm --filter @cc/connect exec wrangler deploy
// Deploy staging: pnpm --filter @cc/connect exec wrangler deploy --env staging
// Secret: wrangler secret put BETTER_AUTH_SECRET [--env staging]
//         (must equal cc-web's BETTER_AUTH_SECRET — the gate verifies the
//         session cookie's HMAC with it)
// Optional var: ASSETLINKS_SHA256_FINGERPRINTS — comma-separated Android
//         signing-cert fingerprints for /.well-known/assetlinks.json (cc
//         mobile app links). Unset until the Android app is signed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "name": "cc-connect",
  "main": "./src/worker.ts",

  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": false },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
  "durable_objects": {
    "bindings": [{ "name": "TUNNEL_DO", "class_name": "TunnelDO" }]
  },
  // Production: every *.cc.example.invalid subdomain hits the gate via the wildcard
  // zone route (backed by a proxied `*` DNS record). The apex + www are
  // custom domains on cc-web and take precedence over this route.
  "vars": { "BASE_DOMAIN": "cc.example.invalid" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cc-connect-prod",
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Shared schema lives in connect-db; CI runs `wrangler d1 migrations
      // apply DB --remote` from this config before every deploy (the
      // d1_migrations tracking tables were seeded with the hand-applied
      // 0000-000N chain on 2026-07-08).
      "migrations_dir": "../../packages/connect-db/migrations"
    }
  ],
  "routes": [],
  "env": {
    "staging": {
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
      "durable_objects": {
        "bindings": [{ "name": "TUNNEL_DO", "class_name": "TunnelDO" }]
      },
      "vars": { "BASE_DOMAIN": "cc-staging.example.invalid" },
      // Staging now has a dashboard-managed wildcard (`*.cc-staging.example.invalid`
      // proxied DNS + zone route to this worker, added 2026-07-08), matching
      // prod's model — new labels/share hosts need no per-host config. The
      // legacy per-host custom domains below predate the wildcard and take
      // precedence over it; they stay declared so a staging deploy never
      // inherits the top-level prod routes (routes inherit across wrangler
      // envs — the same footgun that once stole a domain from cc-web).
      // NOTE: the zone route itself is dashboard-managed because this
      // machine's wrangler token is zone read-only and cannot write routes.
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cc-connect-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/connect-db/migrations"
        }
      ]
    }
  }
}
