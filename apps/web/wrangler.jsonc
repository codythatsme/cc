// cc.example.invalid site — marketing page + cc connect auth/dashboard, TanStack Start on Workers.
//
// Top level = staging (cc-staging.example.invalid); env.production = prod (cc.example.invalid).
// The @cloudflare/vite-plugin resolves the environment at BUILD time via
// CLOUDFLARE_ENV (not `wrangler deploy --env`): the build writes the resolved
// config to dist/server/wrangler.json and a plain `wrangler deploy` follows
// the .wrangler/deploy/config.json redirect to it.
//
// Deploy staging: pnpm --filter @cc/web build && pnpm --filter @cc/web exec wrangler deploy
// Deploy prod:    CLOUDFLARE_ENV=production pnpm --filter @cc/web build
//                 && pnpm --filter @cc/web exec wrangler deploy
// Secrets (per worker): wrangler secret put [--name cc-web] GITHUB_CLIENT_ID /
//   GITHUB_CLIENT_SECRET / BETTER_AUTH_SECRET / RESEND_API_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "name": "cc-web-staging",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server-entry.ts",
  "workers_dev": false,
  "observability": { "enabled": false },
  "vars": {
    "BASE_DOMAIN": "cc-staging.example.invalid",
    "APP_URL": "https://cc-staging.example.invalid",
    // Resend audience that /api/subscribe adds emails to ("cc users").
    // Not a secret — only the API key is.

  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "BETTER_AUTH_SECRET",
      "RESEND_API_KEY",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cc-connect-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNEL_DO",
        "class_name": "TunnelDO",
        "script_name": "cc-connect-staging",
      },
    ],
  },
  // CC Official plugin marketplace. The registry repo (get-cc/marketplace)
  // uploads marketplace.json + icons here; /marketplace/v1/* serves them.
  // The route answers 404 until the bucket exists, so this binding can land
  // before the bucket is provisioned.
  "r2_buckets": [
    {
      "binding": "MARKETPLACE",
      "bucket_name": "cc-marketplace-staging",
    },
  ],
  "routes": [],
  "env": {
    // Production (cc.example.invalid). Cutover note: the cc.example.invalid + www custom domains
    // move here from the old cc-landing worker; until then workers_dev gives a
    // preview URL. `www` is handled by the gate's reserved-handle redirect.
    "production": {
      "name": "cc-web",
      "workers_dev": true,
      "observability": { "enabled": false },
      // Override the inherited staging custom domain; prod domains attach at
      // cutover. Never leave this to inheritance — a prod deploy would steal
      // cc-staging.example.invalid from cc-web-staging.
      "routes": [],
      "secrets": {
        "required": [
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "BETTER_AUTH_SECRET",
          "RESEND_API_KEY",
        ],
      },
      "vars": {
        "BASE_DOMAIN": "cc.example.invalid",
        "APP_URL": "https://cc.example.invalid",

      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cc-connect-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "TUNNEL_DO",
            "class_name": "TunnelDO",
            "script_name": "cc-connect",
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "MARKETPLACE",
          "bucket_name": "cc-marketplace",
        },
      ],
    },
  },
}
